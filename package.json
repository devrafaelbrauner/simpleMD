{
  "name": "simplemd",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Editor de markdown open source (MIT), extensível por plugins e temas.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && prettier --check . && node scripts/check-licenses.mjs --require-destinations && node scripts/check-single-version.mjs && node scripts/build-plugin-example.mjs && git diff --exit-code plugins-examples/calc",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:security": "node scripts/check-tauri-security.mjs && node scripts/check-ci-supply-chain.mjs",
    "deps:fix": "node scripts/deps-fix.mjs",
    "dev": "pnpm --filter @simplemd/desktop tauri dev",
    "dev:desktop": "pnpm --filter @simplemd/desktop tauri dev",
    "dev:harness": "pnpm --filter @simplemd/desktop dev:harness",
    "dev:demo": "pnpm --filter @simplemd/demo dev",
    "tauri": "pnpm --filter @simplemd/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
